{
  "title": "chk 生成器调试样例",
  "fields": [
    { "name": "ID", "type": "text", "length": 6, "label": "调查表编号", "key": true, "noenter": true, "autoenter": "{SEQ}" },
    { "name": "SEX", "type": "number", "digits": 1, "label": "性别", "options": ["【1】男", "【2】女"], "required": true },
    { "name": "PREGNANT", "type": "number", "digits": 1, "label": "是否怀孕", "options": ["【1】是", "【2】否"], "required": true, "range": [1, 2] },
    { "name": "AGE", "type": "number", "digits": 3, "label": "年龄(岁)", "range": [0, 120], "required": true },
    { "name": "MAXTEMP", "type": "number", "digits": "2.1", "label": "最高体温(℃)", "range": [35.0, 42.0] },
    { "name": "MOBILE", "type": "number", "digits": 11, "label": "联系电话", "required": true },
    { "name": "ONSETDT", "type": "date", "label": "发病日期", "required": true, "range": ["01/01/2020", "31/12/2026"] },
    { "name": "SMOKENUM", "type": "number", "digits": 1, "label": "每天吸烟支数", "options": ["【1】1-4支", "【2】5-9支", "【3】10-20支", "【4】>20支"], "jumps": { "1": "NEXT", "2": "NEXT", "3": "NEXT", "4": "TOBACO" } },
    { "name": "TOBACO", "type": "text", "length": 8, "label": "每日吸烟量(注明)", "after": "if {SEX} = 2 then\n  GOTO END\nendif" },
    { "name": "NOTE", "type": "memo", "length": 20, "label": "备注" }
  ]
}
